# Supabase configuration (from https://supabase.com/dashboard -> Project Settings -> API)
# Leave both empty to run in demo mode (in-memory sample data, no login, nothing is saved).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Business timezone used for "today", due dates and overdue days.
# Must match app_today() in supabase/migrations/20261026010000_views_security_timezone_advance.sql
NEXT_PUBLIC_APP_TIMEZONE=Asia/Karachi
